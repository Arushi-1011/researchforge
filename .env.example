APP_ENV=development
# Production: use a unique random secret (32+ chars) and a real HTTPS frontend origin.
DOCS_ENABLED=true
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://researchforge:researchforge@db:5432/researchforge
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
STORAGE_DIR=/app/storage
